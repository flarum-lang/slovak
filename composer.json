{
	"name": "flarum-lang/slovak",
	"description": "Slovak Language Pack for Flarum",
	"type": "flarum-extension",
	"keywords": [
		"flarum-locale"
	],
	"homepage": "https://github.com/flarum-lang/slovak",
	"license": "MIT",
	"support": {
		"issues": "https://github.com/flarum-lang/slovak/issues",
		"forum": "https://discuss.flarum.org/d/20993",
		"source": "https://github.com/flarum-lang/slovak"
	},
	"require": {
		"flarum/core": "^2.0"
	},
	"extra": {
		"flarum-extension": {
			"title": "Slovak",
			"category": "language",
			"icon": {
				"image": "icon.svg",
				"backgroundColor": "#fff",
				"backgroundSize": "cover",
				"backgroundPosition": "center"
			}
		},
		"flarum-locale": {
			"code": "sk",
			"title": "Slovenčina"
		}
	}
}
